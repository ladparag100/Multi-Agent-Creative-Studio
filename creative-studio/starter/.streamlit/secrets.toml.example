# Template for Streamlit Community Cloud secrets.
#
# Local dev does NOT need this file - .env + `gcloud auth application-default
# login` already cover it. This is only for the deployed app: copy this
# content into your app's Settings -> Secrets on share.streamlit.io (or save
# as .streamlit/secrets.toml locally, gitignored, to test the cloud path).

GOOGLE_CLOUD_PROJECT = "your-project-id"
GOOGLE_CLOUD_LOCATION = "global"
GEMINI_MODEL = "gemini-2.5-flash"
GEMINI_IMAGE_MODEL = "gemini-3.1-flash-image"
GCS_IMAGES_BUCKET = "your-project-id-campaign-images"

# URLs printed by `deploy/deploy_all_specialists.py` (or `gcloud run services
# list`) after deploying the 5 specialists to Cloud Run.
STRATEGIST_AGENT_URL = "https://brand-strategist-xxxxxxxxxx-uc.a.run.app"
COPYWRITER_AGENT_URL = "https://copywriter-xxxxxxxxxx-uc.a.run.app"
DESIGNER_AGENT_URL = "https://designer-xxxxxxxxxx-uc.a.run.app"
CRITIC_AGENT_URL = "https://critic-xxxxxxxxxx-uc.a.run.app"
PM_AGENT_URL = "https://project-manager-xxxxxxxxxx-uc.a.run.app"

# Optional Notion integration for the Project Manager agent.
# NOTION_TOKEN = ""
# NOTION_PROJECT_DATABASE_ID = ""
# NOTION_TASKS_DATABASE_ID = ""

# Service account key for Vertex AI / GCS auth (Streamlit Cloud has no
# interactive gcloud login). Create one with:
#   gcloud iam service-accounts create streamlit-creative-studio \
#     --project=your-project-id
#   gcloud projects add-iam-policy-binding your-project-id \
#     --member="serviceAccount:streamlit-creative-studio@your-project-id.iam.gserviceaccount.com" \
#     --role="roles/aiplatform.user"
#   gcloud projects add-iam-policy-binding your-project-id \
#     --member="serviceAccount:streamlit-creative-studio@your-project-id.iam.gserviceaccount.com" \
#     --role="roles/storage.objectAdmin"
#   gcloud iam service-accounts keys create key.json \
#     --iam-account=streamlit-creative-studio@your-project-id.iam.gserviceaccount.com
# Then paste the contents of key.json into the table below (delete key.json
# afterwards - never commit it).
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "streamlit-creative-studio@your-project-id.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
