# Template for Streamlit Community Cloud secrets.
#
# Local dev does NOT need this file - .env + `gcloud auth application-default
# login` already cover it. This is only for the deployed app: copy this
# content into your app's Settings -> Secrets on share.streamlit.io (or save
# as .streamlit/secrets.toml locally, gitignored, to test the cloud path).
#
# No GCP service account is required here. The Creative Director's own
# Gemini calls use a plain API key (below), and generated images are read
# from a public-read GCS bucket over HTTPS. The 5 specialists still use
# Vertex AI, but that's handled by their Cloud Run service accounts - not
# something this app needs to worry about.

# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY = "your-gemini-api-key"
GOOGLE_GENAI_USE_VERTEXAI = "0"

GOOGLE_CLOUD_PROJECT = "your-project-id"
GCS_IMAGES_BUCKET = "your-project-id-campaign-images"

# URLs printed by `deploy/deploy_all_specialists.py` (or `gcloud run services
# list`) after deploying the 5 specialists to Cloud Run.
STRATEGIST_AGENT_URL = "https://brand-strategist-xxxxxxxxxx-uc.a.run.app"
COPYWRITER_AGENT_URL = "https://copywriter-xxxxxxxxxx-uc.a.run.app"
DESIGNER_AGENT_URL = "https://designer-xxxxxxxxxx-uc.a.run.app"
CRITIC_AGENT_URL = "https://critic-xxxxxxxxxx-uc.a.run.app"
PM_AGENT_URL = "https://project-manager-xxxxxxxxxx-uc.a.run.app"

# Optional Notion integration for the Project Manager agent.
# NOTION_TOKEN = ""
# NOTION_PROJECT_DATABASE_ID = ""
# NOTION_TASKS_DATABASE_ID = ""
